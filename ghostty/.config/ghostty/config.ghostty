# --- Appearance ---
font-family = JetBrainsMono Nerd Font
font-size = 12
background-opacity = 0.90

# --- Colors ---
background = #262427
foreground = #fcfcfa
cursor-color = #fcfcfa
cursor-text = #000000
selection-background = #fcfcfa
selection-foreground = #262427

# Normal: black, red, green, yellow, blue, magenta, cyan, white
palette = 0=#262427
palette = 1=#ff666d
palette = 2=#b3e03a
palette = 3=#ffc739
palette = 4=#00cde8
palette = 5=#a392e8
palette = 6=#9deaf6
palette = 7=#fcfcfa

# Bright
palette = 8=#545452
palette = 9=#ff7e83
palette = 10=#bee55e
palette = 11=#ffd05e
palette = 12=#1bd5eb
palette = 13=#b0a3eb
palette = 14=#acedf8
palette = 15=#fcfcfa

# --- Behavior ---
mouse-hide-while-typing = true
shell-integration-features = no-cursor

# --- Window ---
window-padding-balance = true
maximize = true

# --- Keybindings ---
# Alt and plain Ctrl are left to Neovim and the shell.
# Other pane/tab keys use the defaults (ghostty +list-keybinds --default)

# Pane navigation (pairs with <C-hjkl> in Neovim)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Close pane (closes the tab when it is the last pane)
keybind = ctrl+shift+w=close_surface
