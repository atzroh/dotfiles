# --- Appearance ---
# Matches monokai-pro.nvim (filter = pro, transparent background)
theme = Monokai Pro
font-family = JetBrainsMono Nerd Font
font-size = 12
background-opacity = 0.90

# --- Behavior ---
mouse-hide-while-typing = true
shell-integration-features = no-cursor

# --- Window ---
window-padding-balance = true
maximize = true

# --- Keybindings ---
# Alt and plain Ctrl are left to Neovim and the shell.
# Other pane/tab keys use the defaults (ghostty +list-keybinds --default)

# Pane navigation (pairs with <C-hjkl> in Neovim)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Close pane (closes the tab when it is the last pane)
keybind = ctrl+shift+w=close_surface
