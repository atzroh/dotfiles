{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
    },
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "keys": "cyan",
    },
  },
  "modules": [
    {
      "type": "title",
      // Protects privacy by hiding user@host while showing the OS name
      "format": "{6}{7}{8}",
    },

    // --- HARDWARE (Prioritized) ---
    {
      "type": "custom",
      "format": "󰍛 Hardware",
    },
    {
      "type": "host",
      // Unified Device Icon
      "key": "  󰌢 Device",
      // Displays only the product name (e.g., Surface Pro 7)
      "format": "{2}",
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU",
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU",
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory",
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk",
    },
    {
      "type": "battery",
      "key": "  󰁹 Battery",
    },

    // --- SOFTWARE ---
    {
      "type": "custom",
      "format": "󰟀 Software",
    },
    {
      "type": "os",
      // Fixed: Kubuntu logo for JetBrainsMono Nerd Font
      "key": "   OS",
      "format": "{3} {10}",
    },
    {
      "type": "kernel",
      "key": "  󰒋 Kernel",
    },
    {
      "type": "uptime",
      "key": "  󱎫 Uptime",
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
    },
    {
      "type": "locale",
      "key": "  󰇧 Locale",
    },

    // --- ENVIRONMENT ---
    {
      "type": "custom",
      "format": "󰆼 Environment",
    },
    {
      "type": "shell",
      "key": "  󱆃 Shell",
    },
    {
      "type": "terminal",
      "key": "  󰆍 Terminal",
    },
    {
      "type": "terminalfont",
      // Unified Font Icon
      "key": "  󰛖 Term Font",
    },
    {
      "type": "de",
      "key": "  󰖲 DE",
    },
    {
      "type": "wm",
      "key": "  󱂬 WM",
    },

    // --- APPEARANCE ---
    {
      "type": "custom",
      "format": "󰉼 Appearance",
    },
    {
      "type": "wmtheme",
      "key": "  󰉼 WM Theme",
    },
    {
      "type": "theme",
      "key": "  󰔎 Theme",
    },
    {
      "type": "icons",
      "key": "  󰀻 Icons",
    },
    {
      "type": "font",
      // Unified Font Icon
      "key": "  󰛖 Font",
    },
    {
      "type": "cursor",
      "key": "  󰇀 Cursor",
    },

    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
